# OpenLoop configuration.
# These are read from the environment by the OpenCode plugin at load time.
# OpenCode plugins run inside the server process, so you can also export these
# in the shell that launches `opencode serve` / the OpenCode Desktop app.

# CODER agent configuration -------------------------------------------------
# Model in the form "<providerID>/<modelID>" e.g. "ollama-cloud/glm-4.6".
# Leave blank to use the server/agent default model.
OPENLOOP_CODER_MODEL=
# Agent name to use for the coder (must be a "primary" agent in OpenCode).
OPENLOOP_CODER_AGENT=build

# REVIEWER agent configuration ---------------------------------------------
# Independent model/agent from the coder. May be the same or different.
OPENLOOP_REVIEWER_MODEL=
OPENLOOP_REVIEWER_AGENT=build

# Loop configuration -------------------------------------------------------
# Maximum number of coder->reviewer review rounds before OpenLoop stops.
OPENLOOP_MAX_ROUNDS=6
# When true, file-editing tools are disabled for the reviewer session.
OPENLOOP_REVIEWER_READONLY=true
# Per-turn timeout (ms) before a busy session is aborted.
OPENLOOP_TURN_TIMEOUT_MS=1800000
# Status poll interval (ms) used as a fallback when no session event arrives.
OPENLOOP_POLL_INTERVAL_MS=2000